{
  "manifest_version": 3,
  "name": "Digit Laboral · Asistente REOP",
  "description": "Adjunta liquidaciones revisadas al formulario de importación de REOP.",
  "version": "1.3.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "incognito": "not_allowed",
  "externally_connectable": {
    "matches": [
      "https://digit-laboral-app.onrender.com/*"
    ]
  },
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Digit Laboral · Asistente REOP"
  }
}
